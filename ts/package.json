{
  "name": "mtls-menu-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --tsconfig ./tsconfig.base.json src/app/index.tsx",
    "dev": "tsx watch --tsconfig ./tsconfig.base.json src/app/index.tsx",
    "typecheck": "tsc -b",
    "typecheck:watch": "tsc -b --watch",
    "clean": "tsc -b --clean",
    "test": "tsx --tsconfig ./tsconfig.base.json tests/run.ts",
    "test:smoke": "tsx --tsconfig ./tsconfig.base.json tests/mcp-smoke.ts",
    "knip": "knip --no-progress"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ink": "^5.2.1",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/react": "^18.3.12",
    "knip": "^6.29.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
